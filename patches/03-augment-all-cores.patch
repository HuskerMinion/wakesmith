+    # Patched (wakesmith): fan clips out over all CPU cores. The stock loop ran one clip at a time
+    # (~1 core of 12). Set LKW_AUG_WORKERS=1 to get the original serial behavior.
+    import multiprocessing as mp
+    import os
+
+    workers = int(os.environ.get("LKW_AUG_WORKERS", os.cpu_count() or 1))
+    job = (is_positive, round_idx, target_length, sample_rate)
+    desc = f"Augmenting {clip_dir.name} r{round_idx}"
+    if workers <= 1:
+        _worker_init(augmentor, job)
+        for wav_path in tqdm(wav_files, desc=desc, unit="clip"):
+            _augment_one(wav_path)
+        return
+    with mp.get_context("fork").Pool(workers, initializer=_worker_init, initargs=(augmentor, job)) as pool:
+        for _ in tqdm(pool.imap_unordered(_augment_one, wav_files, chunksize=64),
+                      total=len(wav_files), desc=desc, unit="clip"):
+            pass
+
+
+_W: dict[str, Any] = {}
+
+
+def _worker_init(augmentor: AudioAugmentor, job: tuple) -> None:
+    """Per-process state. Forked workers inherit identical RNG state, so reseed each one."""
+    import os
+
+    _W["aug"], _W["job"] = augmentor, job
+    seed = (os.getpid() * 1_000_003 + int.from_bytes(os.urandom(4), "little")) % 2**32
+    random.seed(seed)
+    np.random.seed(seed)
+
+
+def _augment_one(wav_path: Path) -> None:
+    import re
+
+    import soundfile as sf
+
+    augmentor = _W["aug"]
+    is_positive, round_idx, target_length, sample_rate = _W["job"]
+
+    audio, sr = sf.read(str(wav_path))
+    if audio.ndim > 1:
+        audio = audio[:, 0]
+    audio = audio.astype(np.float32)
+
+    # Apply per-sample augmentations
+    audio = augmentor.augment_clip(audio)
+
+    # Apply RIR
+    audio = augmentor.apply_rir(audio)
+
+    # Mix with background
+    audio = augmentor.mix_with_background(audio)
+
+    # Align to target duration only on round 0 (raw TTS clips vary in
+    # length).  Later rounds already have the correct duration.
+    if round_idx == 0:
+        if is_positive:
+            audio = align_clip_to_end(audio, target_length)
+        else:
+            # Center-pad or crop negatives
+            if len(audio) < target_length:
+                padded = np.zeros(target_length, dtype=np.float32)
+                start = (target_length - len(audio)) // 2
+                padded[start : start + len(audio)] = audio
+                audio = padded
+            elif len(audio) > target_length:
+                start = (len(audio) - target_length) // 2
+                audio = audio[start : start + target_length]
+
+    # Derive output name from the original stem (strip any _rN suffix)
+    orig_stem = re.sub(r"_r\d+$", "", wav_path.stem)
+    out_path = wav_path.with_name(f"{orig_stem}_r{round_idx}.wav")
+    sf.write(str(out_path), audio, sample_rate)
