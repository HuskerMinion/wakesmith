# wakesmith settings. Copy to recipe.env and edit; every script reads it (environment
# variables of the same name override it for one run, e.g. `FROM=augment scripts/train.sh`).
# Plain KEY=value lines only: no `export`, no command substitution.

# livekit-wakeword config for your phrase (copy configs/example.yaml). Its model_name names the
# output folder; its data_dir/output_dir are relative to the repo root.
WAKE_CONFIG=configs/example.yaml

# What to train on: xpu (Intel Arc, torch XPU build), cuda (NVIDIA), cpu.
ACCEL=xpu

# GPUs for TTS generation. Two ids = one process per card (positives on the first, sound-alikes on
# the second); one id = a single process. Ignored for ACCEL=cpu.
GEN_GPUS="0 1"
# GPU for training (and, on Intel, feature extraction).
GPU=0

# Feature extraction backend: openvino (separate .venv-ov with onnxruntime-openvino; runs on an
# Intel GPU, or on the CPU with OPENVINO_DEVICE=CPU) or cpu (stock onnxruntime, batched).
EXTRACT=openvino
OPENVINO_DEVICE=GPU

# Also export an openWakeWord-compatible .tflite (DNN head; needs .venv-tflite with TensorFlow).
OWW_TFLITE=1
# Also train a microWakeWord model (ESPHome devices; needs .venv-mww; trains on the CPU).
MWW=1

# Real recordings (optional but strongly recommended; see README "Real recordings").
# Each folder: WAV files (16 kHz mono), optional labels.csv (column "file", paths relative to the
# folder) and optional HELDOUT.txt (one relative path per line: never trained on, used for scoring).
REAL_POS_DIR=
REAL_NEG_DIR=
# Copies of each real clip injected into the training set (each copy is augmented differently).
REAL_COPIES=10
REAL_NEG_COPIES=2
MWW_REAL_COPIES=10
MWW_REAL_NEG_COPIES=5
# Ignore this much audio at the end of each positive clip when locating the phrase (e.g. a device's
# confirmation chime). 0 for clips recorded by hand.
TRIM_IGNORE_TAIL_S=0.3

# Everything generated (clips, features, models, prepared real clips, review verdicts) goes here.
WORK=work
