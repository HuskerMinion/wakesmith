@@ -296,6 +296,10 @@
     else:
         logw = model.dp(x_enc, x_mask, g=g)
 
+    # Patched (wakesmith): the stochastic duration predictor occasionally returns NaN/inf on XPU,
+    # which makes y_lengths absurd and fails (or OOMs) the whole TTS batch. Cap each phoneme
+    # at ~50 frames (~0.6 s) so one bad item can't take the batch down.
+    logw = torch.nan_to_num(logw, nan=0.0, posinf=4.0, neginf=-4.0).clamp(-4.0, 4.0)
     w = torch.exp(logw) * x_mask * length_scale
     w_ceil = torch.ceil(w)
     y_lengths = torch.clamp_min(torch.sum(w_ceil, [1, 2]), 1).long()
