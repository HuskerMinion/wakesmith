-    all_features: list[np.ndarray] = []
+    # Patched (wakesmith): batch clips through the embedding model (identical output; the stock
+    # loop ran one clip per ONNX call). Only the last N_EMBEDDING_TIMESTEPS windows are kept,
+    # so only those are computed. LKW_FEAT_BATCH sets the clips per batch.
+    import os
 
-    for wav_path in tqdm(wav_files, desc=f"Features {clip_dir.name}", unit="clip"):
-        audio, sr = sf.read(str(wav_path))
-        if audio.ndim > 1:
-            audio = audio[:, 0]
-        audio = audio.astype(np.float32)
-
-        mel = mel_frontend(audio)
-        embeddings = speech_embedding.extract_embeddings(mel)
-        all_features.append(_pad_or_truncate(embeddings[0]))
+    all_features: list[np.ndarray] = []
+    batch = int(os.environ.get("LKW_FEAT_BATCH", "256"))
+    with tqdm(total=len(wav_files), desc=f"Features {clip_dir.name}", unit="clip") as pbar:
+        for s in range(0, len(wav_files), batch):
+            win_sets = []
+            for wav_path in wav_files[s : s + batch]:
+                audio, sr = sf.read(str(wav_path))
+                if audio.ndim > 1:
+                    audio = audio[:, 0]
+                mel = mel_frontend(audio.astype(np.float32))[0]  # (frames, 32)
+                n_win = max(0, (mel.shape[0] - 76) // 8 + 1)
+                first = max(0, n_win - N_EMBEDDING_TIMESTEPS)
+                win_sets.append(
+                    np.stack([mel[i * 8 : i * 8 + 76] for i in range(first, n_win)])
+                    if n_win
+                    else np.zeros((0, 76, 32), np.float32)
+                )
+            flat = np.concatenate(win_sets)
+            embs = speech_embedding(flat) if len(flat) else np.zeros((0, 96), np.float32)
+            k = 0
+            for w in win_sets:
+                all_features.append(_pad_or_truncate(embs[k : k + len(w)]))
+                k += len(w)
+            pbar.update(len(win_sets))
 
     if not all_features:
         return np.zeros((0, N_EMBEDDING_TIMESTEPS, 96), dtype=np.float32)
